 179   2                  if (setupmenu == 0x02)  
 180   2                  { 
 181   3                    CALIB       ();                  
 182   3                  } 
 183   2                  
 184   2                  if (setupmenu == 0x03)  
 185   2                  { 
 186   3                    EDIT        ();                                        
 187   3                  }
 188   2                  
 189   2                  }
 190   1                  }
