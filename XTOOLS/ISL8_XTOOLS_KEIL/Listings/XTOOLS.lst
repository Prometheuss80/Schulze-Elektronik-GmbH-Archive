 270          
 271          void WATCHDOG(void) interrupt 1
 272                      {
 273   1                  TH0 = (65535 - 41666) / 256;     // 1000ms
 274   1                  TL0 = (65535 - 41666) % 256;
 275   1                  if (++timerCount==16) 
 276   1                  {
 277   2                  timerCount = 0x00;
 278   2                  ZERO_WDT = !ZERO_WDT;
 279   2                  }
 280   1                  }
