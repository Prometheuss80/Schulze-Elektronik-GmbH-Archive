 163          /*------------------------------------------------
 164          MAIN C Function
 165          ------------------------------------------------*/
 166          void        MAIN() {
 167   1                  while (1) {
 168   2      
 169   2                  if (setupmenu == 0x00)  
 170   2                  { 
 171   3                    SETUP       ();                     
 172   3                  }            
 173   2                 
 174   2                  if (setupmenu == 0x01)  
 175   2                  { 
 176   3                    TIMEKEEPER  ();                    
 177   3                  }    
 178   2                  
