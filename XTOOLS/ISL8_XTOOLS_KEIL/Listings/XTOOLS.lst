1180   1                        
1181   1          NUM_0 = SN_NUMBER % 10;  
1182   1          SN_NUMBER /= 10;
1183   1          NUM_1 = SN_NUMBER % 10;
1184   1          SN_NUMBER /= 10;
1185   1          NUM_2 = SN_NUMBER % 10;
