                     159     
                     160     IF PDATALEN <> 0
0014 7800            161                     MOV     R0,#LOW (PDATASTART)
0016 7FFF            162                     MOV     R7,#LOW (PDATALEN)
0018 E4              163                     CLR     A
0019 F2              164     PDATALOOP:      MOVX    @R0,A
001A 08              165                     INC     R0
001B DFFC            166                     DJNZ    R7,PDATALOOP
                     167     ENDIF
                     168     
