                      00150 ; Podprogram PAUSE pro LCD
                      00151 ;========================================================================================
                      00152 ;
                      00153 ; casy pro frekvenci krystalu 4,00Mhz
                      00154 ; casy jsou spocitane od call CEKxxm do navratu na volani CEKxxm
                      00155 ; celkovy vypocet  = 2+6+(2+(TMP0-1)*3+2)+3)*TMP1-1+2
                      00156 ; zkraceny vypocet = 8+((TMP0-1)*3+7)*TMP1+1
                      00157 ; mala smycka = (TMP2-1)*3+2
                      00158 ;
                      00159 
                      00160                 
0021   0C02           00161 CEK200m         movlw   .2              ; TMP2 = 2  cekej 0,2 sekundu
0022   0034           00162                 movwf   TMP3
0023   0A??           00163                 goto    SMYCKA2 
                      00164 
0024   0CCF           00165 CEK100m         movlw   0CFh            ; cas = 100,009 ms
0025   0031           00166                 movwf   TMP0
0026   0CA0           00167                 movlw   0A0h
0027   0032           00168                 movwf   TMP1
0028   0A??           00169                 goto    SMYCKA
                      00170 
0029   09??           00171 SMYCKA2         call    CEK100m
002A   02F4           00172                 decfsz  TMP3,F          ; nejvetsi smycka
002B   0A??           00173                 goto    SMYCKA2
002C   0800           00174                 retlw   00h
                      00175         
002D   0211           00176 SMYCKA          movf    TMP0,W
002E   0033           00177                 movwf   TMP2
                      00178                 
002F   02F3           00179 SMYCKA1         decfsz  TMP2,F          ; mala smycka
0030   0A??           00180                 goto    SMYCKA1
0031   02F2           00181                 decfsz  TMP1,F          ; velka smycka
0032   0A??           00182                 goto    SMYCKA
0033   0800           00183                 retlw   00h
                      00184 
                      00185 ;========================================================================================
                      00186 ; Konec programu
                      00187 ;========================================================================================
                      00188 
0FEA                  00189                 end
